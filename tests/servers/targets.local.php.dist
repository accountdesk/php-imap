<?php
/*
* File: targets.local.php.dist
* Category: Test configuration
* Created: 24.10.26
* Updated: -
*
* Description:
*  Template for tests/servers/targets.local.php (gitignored): real provider accounts for the live tests.
*  Copy this file to targets.local.php, fill in the credentials and run e.g.
*      IMAP_TARGETS=gmx .claude/scripts/phpunit.sh tests/live/ServerMatrixTest.php
*      .claude/scripts/imap-servers.sh live gmx
*  Entries are merged over tests/servers/targets.php (same keys, see there). Use dedicated test accounts:
*  the live tests create/delete folders and append/delete messages.
*  Provider targets have no Toxiproxy proxy ("proxy" => null); tests needing one skip them.
*/

return [
    // GMX (FreeMail): IMAP must be enabled in the web mailer (Settings > POP3/IMAP).
    // Folders: "Gesendet", "Entwürfe", "Gelöscht", "Spamverdacht"; delimiter "/".
    "gmx" => [
        "host"           => "imap.gmx.net",
        "port"           => 993,
        "encryption"     => "ssl",
        "validate_cert"  => true,
        "username"       => "your-account@gmx.de",
        "password"       => "your-password",
        "authentication" => null,
        "kind"           => "provider",
        "proxy"          => null,
        "delimiter"      => "/",
        "quota"          => false,
        "notes"          => "GMX. IMAP access has to be enabled in the account settings.",
    ],

    // WEB.DE (same platform as GMX): enable "POP3/IMAP Abruf" in the settings.
    "webde" => [
        "host"           => "imap.web.de",
        "port"           => 993,
        "encryption"     => "ssl",
        "validate_cert"  => true,
        "username"       => "your-account@web.de",
        "password"       => "your-password",
        "authentication" => null,
        "kind"           => "provider",
        "proxy"          => null,
        "delimiter"      => "/",
        "quota"          => false,
        "notes"          => "WEB.DE. IMAP access has to be enabled in the account settings.",
    ],

    // Gmail: requires 2-step verification and an app password (https://myaccount.google.com/apppasswords).
    // Folders are labels below "[Gmail]/..."; deleting a message in INBOX only removes the label.
    "gmail" => [
        "host"           => "imap.gmail.com",
        "port"           => 993,
        "encryption"     => "ssl",
        "validate_cert"  => true,
        "username"       => "your-account@gmail.com",
        "password"       => "xxxx xxxx xxxx xxxx", // 16 character app password
        "authentication" => null,
        "kind"           => "provider",
        "proxy"          => null,
        "delimiter"      => "/",
        "quota"          => true,
        "notes"          => "Gmail with app password. Labels instead of folders, [Gmail]/ special folders.",
    ],

    // Exchange Online / Outlook.com: basic auth is disabled, XOAUTH2 only. "password" is the OAuth2
    // access token (scope https://outlook.office.com/IMAP.AccessAsUser.All offline_access); it expires
    // after about an hour, so fetch a fresh one before running the tests.
    "outlook" => [
        "host"           => "outlook.office365.com",
        "port"           => 993,
        "encryption"     => "ssl",
        "validate_cert"  => true,
        "username"       => "your-account@your-tenant.onmicrosoft.com",
        "password"       => "oauth2-access-token",
        "authentication" => "oauth",
        "kind"           => "provider",
        "proxy"          => null,
        "delimiter"      => "/",
        "quota"          => false,
        "notes"          => "Exchange Online / Outlook.com via XOAUTH2 (access token as password).",
    ],
];
